# DataTaxonomy environment variables
# Copy this file to .env and enter the user's own API key.
# Never share .env or include it in a release package.

OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_BACKUP=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Codex uses OPENAI_API_KEY above, via the OpenAI Responses API.
DEEPSEEK_API_KEY=
CUSTOM_API_KEY=
# Optional global model override; leave blank to use the UI model.
MODEL=
